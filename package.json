{
  "name": "mcp-seo-auditor",
  "version": "0.1.5",
  "description": "MCP server for on-page SEO audits: check titles, meta descriptions, canonicals, robots and JSON-LD in HTML or URLs, with bounded crawling. For Claude, Cursor and Codex.",
  "mcpName": "io.github.petrovicistefan/mcp-seo-auditor",
  "type": "module",
  "bin": {
    "mcp-seo-auditor": "bin/mcp-seo-auditor.mjs"
  },
  "files": [
    "bin/",
    "src/mcp_seo_auditor/*.py",
    "README.md",
    "LICENSE",
    "pyproject.toml"
  ],
  "scripts": {
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
    "check:rules": "node scripts/check-rules.mjs",
    "check": "npm run check:rules",
    "prepublishOnly": "npm run check:rules && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrovicistefan/mcp-seo-auditor.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "seo",
    "seo-audit",
    "on-page-seo",
    "technical-seo",
    "meta-tags",
    "canonical",
    "robots-txt",
    "json-ld",
    "structured-data",
    "crawler",
    "read-only",
    "local-first",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "copilot"
  ],
  "homepage": "https://github.com/petrovicistefan/mcp-seo-auditor#readme",
  "bugs": {
    "url": "https://github.com/petrovicistefan/mcp-seo-auditor/issues"
  },
  "author": "Stefan Petrovici"
}
